{
  "name": "potopi-photobooth",
  "version": "0.1.11",
  "private": true,
  "main": "main.js",
  "author": "CtechAgency",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dikhsantibong/potopiphotobothv2.git"
  },
  "description": "Potopi Photobooth Machine Application",
  "scripts": {
    "dev": "next dev",
    "dev:electron": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "dist": "npm run build && electron-builder",
    "test:digicam": "node scripts/test-digicam.mjs",
    "test:camera-config": "node scripts/test-camera-config.mjs",
    "test:exif": "node scripts/test-exif.mjs",
    "version:sync": "node scripts/sync-lock-version.mjs",
    "release": "npm version patch --no-git-tag-version && npm run version:sync"
  },
  "dependencies": { 
    "@ffmpeg/core": "^0.12.6",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "localforage": "^1.10.0",
    "next": "16.2.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-qr-code": "^2.0.18",
    "react-simple-keyboard": "^3.8.204"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "electron": "^41.1.1",
    "electron-builder": "^25.1.8",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.0.4"
  },
  "build": {
    "publish": [{
      "provider": "github",
      "owner": "Dikhsantibong",
      "repo": "potopiphotobothv2",
      "releaseType": "release"
    }],
    "compression": "store",
    "appId": "com.roambooth.machine1",
    "productName": "RoamBooth Machine",
    "directories": {
      "output": "dist_installer"
    },
    "files": [
      "main.js",
      "preload.js",
      "electron/**/*",
      ".next/**/*",
      "!.next/cache/**/*",
      "!.next/cache",
      "!.next/dev/**/*",
      "!.next/dev",
      "!**/*.map",
      "public/**/*",
      ".env",
      "package.json",
      "node_modules/**/*",
      "!node_modules/electron{,/**/*}",
      "!node_modules/electron-builder{,/**/*}",
      "!node_modules/app-builder-bin{,/**/*}",
      "!node_modules/7zip-bin{,/**/*}",
      "!node_modules/typescript{,/**/*}",
      "!node_modules/@types{,/**/*}",
      "!node_modules/eslint*{,/**/*}"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/favicon.ico"
    },
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**/*"
    ]
  }
}
